# DO NOT COMMIT OR SEND YOUR REAL PASSWORD.
# Copy to .env ONLY in a protected local/server environment.
FEQH_AUTH_USERNAME=scholar
FEQH_AUTH_PASSWORD=REPLACE_WITH_YOUR_OWN_UNIQUE_LONG_PASSWORD_24_PLUS_CHARS
# Production Coolify / HTTPS proxy; do not expose origin port directly to Internet.
PORT=3000
FEQH_HOST=0.0.0.0
FEQH_TRUST_PROXY=1
# Never enable HTTP dev mode on a public interface:
FEQH_ALLOW_HTTP_DEV=0
